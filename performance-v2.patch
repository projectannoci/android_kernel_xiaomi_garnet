 obj-$(CONFIG_TRACE_GPU_MEM)		+= trace/
+
+obj-$(CONFIG_QCOM_KGSL) += msm/
--- a/drivers/video/Kconfig
+++ b/drivers/video/Kconfig
@@ -48,3 +48,5 @@
 
 
 endmenu
+
+source "drivers/gpu/msm/Kconfig"
--- a/mm/vmscan.c
+++ b/mm/vmscan.c
@@ -179,7 +179,7 @@
 /*
  * From 0 .. 200.  Higher means more swappy.
  */
-int vm_swappiness = 60;
+int vm_swappiness = IS_ENABLED(CONFIG_GARNET_PERFORMANCE) ? 0 : 60;
 
 struct kcompress_t kcompress_data[MAX_NUMNODES];
 
--- a/net/ipv4/tcp_cong.c
+++ b/net/ipv4/tcp_cong.c
@@ -252,7 +252,7 @@
 static int __init tcp_congestion_default(void)
 {
 	return tcp_set_default_congestion_control(&init_net,
-						  CONFIG_DEFAULT_TCP_CONG);
+						  IS_ENABLED(CONFIG_GARNET_PERFORMANCE) ? "bbr" : CONFIG_DEFAULT_TCP_CONG);
 }
 late_initcall(tcp_congestion_default);
 
