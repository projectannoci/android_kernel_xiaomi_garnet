--- a/arch/arm64/Kconfig
+++ b/arch/arm64/Kconfig
@@ -2187,3 +2187,10 @@
 if CRYPTO
 source "arch/arm64/crypto/Kconfig"
 endif
+
+config GARNET_PERFORMANCE
+	bool "Garnet performance policy"
+	depends on ARCH_QCOM
+	default n
+	help
+	  Build the Garnet CPU/GPU, memory, I/O and network policy.
--- a/block/mq-deadline-main.c
+++ b/block/mq-deadline-main.c
@@ -28,8 +28,10 @@
 /*
  * See Documentation/block/deadline-iosched.rst
  */
-static const int read_expire = HZ / 10;  /* max time before a read is submitted. */
-static const int write_expire = HZ; /* ditto for writes, these limits are SOFT! */
+static const int read_expire = IS_ENABLED(CONFIG_GARNET_PERFORMANCE) ?
+	(50 * HZ + 999) / 1000 : HZ / 10;  /* max time before a read is submitted. */
+static const int write_expire = IS_ENABLED(CONFIG_GARNET_PERFORMANCE) ?
+	(200 * HZ + 999) / 1000 : HZ; /* ditto for writes, these limits are SOFT! */
 /*
  * Time after which to dispatch lower priority requests even if higher
  * priority requests are pending.
--- a/drivers/gpu/Makefile
+++ b/drivers/gpu/Makefile
@@ -6,3 +6,5 @@
 obj-y			+= drm/ vga/
